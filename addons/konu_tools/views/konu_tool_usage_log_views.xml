<odoo>
    <record id="view_konu_tool_usage_log_list" model="ir.ui.view">
        <field name="name">konu.tool.usage.log.list</field>
        <field name="model">konu.tool.usage.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="not success">
                <field name="timestamp"/>
                <field name="connection_id"/>
                <field name="tool_id" optional="show"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="model_called"/>
                <field name="method_called"/>
                <field name="success" widget="boolean_toggle"/>
                <field name="message" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_konu_tool_usage_log_form" model="ir.ui.view">
        <field name="name">konu.tool.usage.log.form</field>
        <field name="model">konu.tool.usage.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="timestamp"/>
                            <field name="connection_id"/>
                            <field name="tool_id"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="action"/>
                            <field name="model_called"/>
                            <field name="method_called"/>
                            <field name="success"/>
                        </group>
                    </group>
                    <separator string="Message"/>
                    <field name="message"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_konu_tool_usage_log" model="ir.actions.act_window">
        <field name="name">Usage Log</field>
        <field name="res_model">konu.tool.usage.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
