<odoo>
    <record id="view_konu_customer_connection_list" model="ir.ui.view">
        <field name="name">konu.customer.connection.list</field>
        <field name="model">konu.customer.connection</field>
        <field name="arch" type="xml">
            <list string="Customer Connections" decoration-muted="not active"
                  decoration-success="api_key_set and active"
                  decoration-warning="not api_key_set">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="project_id" optional="show"/>
                <field name="environment"/>
                <field name="odoo_version" optional="show"/>
                <field name="base_url"/>
                <field name="db_name"/>
                <field name="api_key_set" string="Key" widget="boolean_toggle" readonly="1"/>
                <field name="allow_write" widget="boolean_toggle"/>
                <field name="mcp_exposed" widget="boolean_toggle" optional="show"/>
                <field name="last_used" optional="show"/>
                <field name="use_count" optional="show"/>
                <field name="active" widget="boolean_toggle" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_konu_customer_connection_kanban" model="ir.ui.view">
        <field name="name">konu.customer.connection.kanban</field>
        <field name="model">konu.customer.connection</field>
        <field name="arch" type="xml">
            <kanban default_group_by="partner_id" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="environment"/>
                <field name="api_key_set"/>
                <field name="allow_write"/>
                <field name="last_used"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                            </div>
                            <div class="o_kanban_record_subtitle">
                                <field name="environment"/> · <field name="db_name"/>
                            </div>
                            <div>
                                <span t-if="!record.api_key_set.raw_value" class="badge text-bg-warning">no key</span>
                                <span t-if="record.api_key_set.raw_value" class="badge text-bg-success">✓ key</span>
                                <span t-if="record.allow_write.raw_value" class="badge text-bg-danger">write</span>
                                <span t-if="!record.allow_write.raw_value" class="badge text-bg-secondary">read-only</span>
                            </div>
                            <div t-if="record.last_used.raw_value" class="text-muted o_kanban_record_subtitle">
                                last used <field name="last_used"/>
                            </div>
                            <div class="oe_kanban_bottom_right">
                                <button name="action_open_visualiser" type="object" class="btn btn-sm btn-primary">
                                    Open Visualiser
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_konu_customer_connection_form" model="ir.ui.view">
        <field name="name">konu.customer.connection.form</field>
        <field name="model">konu.customer.connection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_visualiser" type="object" class="oe_highlight"
                            string="Open Visualiser" icon="fa-cube"/>
                    <button name="action_test_connection" type="object" string="Test Connection"
                            icon="fa-bolt"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Calls"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="acme-staging"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="project_id"/>
                            <field name="environment"/>
                            <field name="odoo_version"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="allow_write" widget="boolean_toggle"/>
                            <field name="mcp_exposed" widget="boolean_toggle"/>
                            <field name="last_used" readonly="1"/>
                            <field name="use_count" readonly="1"/>
                        </group>
                    </group>
                    <group string="Endpoint">
                        <field name="base_url" placeholder="https://customer.odoo.com"/>
                        <field name="db_name"/>
                        <field name="login"/>
                    </group>
                    <group string="API Key" groups="konu_tools.group_konu_tools_admin">
                        <field name="api_key_set" readonly="1"/>
                        <field name="api_key_input" password="True"
                               placeholder="Paste customer API key — saves encrypted"/>
                        <button name="clear_api_key" type="object" string="Clear API Key"
                                class="btn-link" confirm="Clear the stored API key for this connection?"
                                invisible="not api_key_set"/>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Hook: when an admin types into api_key_encrypted, intercept on save and
         re-encrypt. Implemented as a small override below in the model OR via
         an onchange. For simplicity we encrypt on write inside set_api_key -->
    <record id="action_konu_customer_connection" model="ir.actions.act_window">
        <field name="name">Customer Connections</field>
        <field name="res_model">konu.customer.connection</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No customer connections yet.</p>
            <p>A connection points at one customer Odoo database (URL + DB + login + API key) and is reusable by every Konu tool — the Inventory Visualiser, the odoo-customer MCP server, and any future tool that needs to talk to a customer instance.</p>
        </field>
    </record>
</odoo>
