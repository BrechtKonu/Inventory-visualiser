<odoo>
    <record id="view_konu_tool_list" model="ir.ui.view">
        <field name="name">konu.tool.list</field>
        <field name="model">konu.tool</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="technical_name"/>
                <field name="requires_connection"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_konu_tool_form" model="ir.ui.view">
        <field name="name">konu.tool.form</field>
        <field name="model">konu.tool</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="technical_name"/>
                            <field name="icon"/>
                            <field name="color" widget="color_picker"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                            <field name="requires_connection"/>
                        </group>
                    </group>
                    <group string="URL Template">
                        <field name="url_template"/>
                    </group>
                    <group string="Access">
                        <field name="group_ids" widget="many2many_tags"/>
                    </group>
                    <separator string="Description"/>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_konu_tool" model="ir.actions.act_window">
        <field name="name">Tool Catalog</field>
        <field name="res_model">konu.tool</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
